{
  "name": "dsh-polza",
  "version": "0.1.2",
  "description": "Polza.ai balance and spend statistics for DeepSeek Harness",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": {
      "default": "./src/host/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/host",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "node test/host-smoke.mjs && node test/units.mjs && node test/render.mjs && node test/dom.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XaPoHbomj/dsh-polza.git"
  },
  "homepage": "https://github.com/XaPoHbomj/dsh-polza#readme",
  "bugs": {
    "url": "https://github.com/XaPoHbomj/dsh-polza/issues"
  },
  "author": "Aleksandr Vashchenko",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "polza",
    "polza-ai",
    "balance",
    "usage",
    "cost"
  ],
  "publishConfig": {
    "access": "public"
  }
}
